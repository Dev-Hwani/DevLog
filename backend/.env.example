# Copy this file to backend/.env for local development.
# Do not commit backend/.env.

# Required
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars

# Optional (defaults to local dev URL when omitted)
# DB_URL=jdbc:mysql://localhost:3306/devlog_db?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8

# Optional OAuth settings
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
